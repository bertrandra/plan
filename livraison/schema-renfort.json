{
  "format": "plan-schema-renfort",
  "version": 1,
  "note": "Sortie structuree du renfort de Claude pour le calage et la detection des facades (spec-facades-calage-detection.md 12 bis, lot L18). Coins en reperes de la grille dessinee sur la photo (colonnes et lignes de 0 a 10), ouvertures manquees en metres sur l'elevation, avis sur chaque ouverture numerotee par Plan ; indetermine partout, indices avant la conclusion. Plan recale chaque position sur l'image : ce ne sont que des graines. Le schema part tel quel dans output_config.format ; un changement de champ ou de terme change la version, qui suit chaque ligne du journal.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mur", "coins", "ouvertures", "manquees", "confiance"],
    "properties": {
      "mur": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indices", "vu"],
        "properties": {
          "indices": { "$ref": "#/$defs/indices" },
          "vu": { "type": "string", "enum": ["attendu", "autre", "indetermine"] }
        }
      },
      "coins": {
        "type": "object",
        "additionalProperties": false,
        "required": ["indices", "hautGauche", "hautDroit", "basDroit", "basGauche"],
        "properties": {
          "indices": { "$ref": "#/$defs/indices" },
          "hautGauche": { "$ref": "#/$defs/repere" },
          "hautDroit": { "$ref": "#/$defs/repere" },
          "basDroit": { "$ref": "#/$defs/repere" },
          "basGauche": { "$ref": "#/$defs/repere" }
        }
      },
      "ouvertures": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indices", "numero", "decision", "raison", "type", "volets", "coffre", "balcon", "forme"],
          "properties": {
            "indices": { "$ref": "#/$defs/indices" },
            "numero": { "type": "integer" },
            "decision": { "type": "string", "enum": ["garder", "retirer", "indetermine"] },
            "raison": { "type": "string", "enum": ["ombre", "volet", "tache", "reflet", "vegetation", "vehicule", "autre", "sans-objet"] },
            "type": { "$ref": "#/$defs/typeOuverture" },
            "volets": { "type": "string", "enum": ["battants", "roulant", "persiennes", "aucun", "indetermine"] },
            "coffre": { "$ref": "#/$defs/ouiNon" },
            "balcon": { "$ref": "#/$defs/ouiNon" },
            "forme": { "type": "string", "enum": ["rectangulaire", "cintree", "oeil-de-boeuf", "indetermine"] }
          }
        }
      },
      "manquees": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indices", "type", "x", "y", "l", "h"],
          "properties": {
            "indices": { "$ref": "#/$defs/indices" },
            "type": { "type": "string", "enum": ["fenetre", "porte-fenetre", "porte", "garage"] },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "l": { "type": "number" },
            "h": { "type": "number" }
          }
        }
      },
      "confiance": { "type": "string", "enum": ["faible", "moyenne", "forte"] }
    },
    "$defs": {
      "indices": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "vu"],
          "properties": {
            "image": { "type": "integer" },
            "vu": { "type": "string" }
          }
        }
      },
      "repere": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["colonne", "ligne"],
            "properties": {
              "colonne": { "type": "number" },
              "ligne": { "type": "number" }
            }
          },
          { "type": "string", "enum": ["indetermine"] }
        ]
      },
      "typeOuverture": { "type": "string", "enum": ["fenetre", "porte-fenetre", "porte", "garage", "indetermine"] },
      "ouiNon": { "type": "string", "enum": ["oui", "non", "indetermine"] }
    }
  }
}
