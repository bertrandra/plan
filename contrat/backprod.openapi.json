        "operationId": "updateProject",
        "summary": "Change a project",
        "description": "Partial: an absent field is untouched. Saving does not create a version — versioning is explicit, so an autosave cannot bury the snapshot somebody meant to keep.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductHeader"
          },
          {
            "$ref": "#/components/parameters/TenantHeader"
          },
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "schema_version": {
                    "type": "integer"
                  },
