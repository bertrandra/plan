                  "type": "object",
                  "required": [
                    "versions"
                  ],
                  "properties": {
                    "versions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectVersionSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "description": "How many to return."
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "description": "How many to skip."
      },
      "ProductHeader": {
        "name": "X-Product",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Which product this request is about. Required on everything except discovery and the public surface — a resource endpoint without it is refused rather than guessed at (§12.1)."
      },
      "TenantHeader": {
        "name": "X-Tenant",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Which tenant, when the caller belongs to more than one. Checked against membership, never believed on its own."
      }
    },
    "responses": {
      "InternalError": {
        "description": "A controlled 500 (§37.9). The diagnostic detail is in the server log against this request_id, never on the wire.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotConfigured": {
        "description": "This deployment cannot issue sessions: no signing secret is configured.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such thing — or none this caller may see. The two are deliberately indistinguishable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PermissionDenied": {
        "description": "Authenticated, but not allowed to do this here.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "The caller has spent its allowance for the current window (§31).",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait. A client told only \"too many\" would guess, and a guessing client retries too soon.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "No credential, or one that did not verify.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Entitlement": {
        "type": "object",
        "required": [
          "feature",
          "name",
          "kind",
          "unit",
          "limit",
          "unlimited",
          "source",
          "valid_until"
        ],
        "properties": {
          "feature": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "BOOLEAN",
              "QUOTA"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Null means two different things, so `unlimited` says which."
          },
          "unlimited": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "description": "What produced it — a subscription grant, or an override negotiated outside one. `GRANT`: given by the platform without a sale (docs/tenant-roots.md §2.8) — shown as “provided by the platform”, never as a subscription to cancel.",
            "enum": [
              "SUBSCRIPTION",
              "OVERRIDE",
              "GRANT"
            ]
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "The §10.4 envelope. Every failure has this shape, whatever produced it.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable and machine-readable. Branch on this, never on the message.",
                "examples": [
                  "PERMISSION_DENIED"
                ]
              },
              "message": {
                "type": "string",
                "description": "For a person. Wording may change without notice."
              },
              "details": {
                "type": "object",
                "description": "What the code could not say alone — the field at fault, the limit exceeded. Empty rather than absent.",
                "additionalProperties": true
              },
              "request_id": {
                "type": "string",
                "description": "Quote this when reporting a problem; the server log is keyed by it."
              }
            }
          }
        }
      },
      "Project": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProjectSummary"
          },
          {
            "type": "object",
            "required": [
              "document"
            ],
            "properties": {
              "document": {
                "$ref": "#/components/schemas/ProjectDocument"
              }
            }
          }
        ]
      },
      "ProjectDocument": {
        "type": "object",
        "additionalProperties": true,
        "description": "The JSONB document. Key order is preserved and insignificant whitespace is gone — what is stored is what comes back, which is the guarantee snapshot and restore rest on. Large assets are refused here and belong in storage (non-negotiable #9)."
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "schema_version",
          "created_by",
          "created_at",
          "updated_at",
          "deleted_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_version": {
            "type": "integer",
            "description": "Which document shape this is. Enforced on write (non-negotiable #10): an unknown version is refused rather than stored and puzzled over later."
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When somebody deleted it, or null while it is live. A deleted project keeps its versions, its assets and every job that referred to it — deletion is a date, not a cascade (R13)."
          }
        }
      },
      "ProjectVersionSummary": {
        "type": "object",
        "required": [
          "id",
          "version_number",
          "label",
          "name",
          "description",
          "schema_version",
          "created_by",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version_number": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_version": {
            "type": "integer"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Present it as `Authorization: Bearer <token>`. Hold it in memory; it is short-lived by design."
          },
          "token_type": {
            "type": "string",
            "examples": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "description": "Seconds from now. A duration rather than an instant, so a browser with a skewed clock still schedules its renewal correctly.",
            "examples": [
              3600
            ]
          }
        },
        "description": "The refresh token is deliberately absent: it leaves in an `HttpOnly` cookie that no script can read, and putting it here as well would throw away the reason the cookie exists."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An RS256 access token from the identity provider, verified locally against its published keys. Swapping provider is an adapter change (ADR-014)."
      }
    }
  }
}
