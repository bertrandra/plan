# Sorties d'export : regenerables a tout moment depuis l'application, et le .glb pese 40 Mo.
/Export/

# Copies de secours ecrites par api.php a chaque enregistrement de projet.
data/*.bak
*.bak

# Windows / OneDrive
Thumbs.db
desktop.ini

# Sauvegardes manuelles anterieures au depot : c'est exactement ce que git remplace desormais.
BKP */

# Chaine Node (phase 1 de la migration)
# Sans barre finale : le motif couvre aussi un lien symbolique (celui d'un worktree de livraison).
node_modules
dist/
dist-banc/
# Sauf les bibliotheques copiees dans la livraison (deploy/bibliotheques.mjs) : pdf-lib range son module sous dist/, et une
# livraison tiree de git sans lui retomberait sur jsDelivr.
!livraison/assets/vendor/**/dist/

# Rapport de couverture, regenere par npm run test -- --coverage
coverage/

# Captures de reference de l interface (scripts/captures.mjs) : regenerees a chaque etape, jointes a la PR.
tests/captures/
livraison.zip
