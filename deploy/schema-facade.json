                  "$ref": "#/$defs/compte"
                },
                "petitsBois": {
                  "type": "string",
                  "enum": [
                    "aucun",
                    "fins",
                    "epais",
                    "indetermine"
                  ]
                },
                "imposte": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "hauteur",
                        "colonnes",
                        "rangees"
                      ],
                      "properties": {
                        "hauteur": {
                          "type": "number"
                        },
                        "colonnes": {
