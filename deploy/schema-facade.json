                }
              }
            }
          },
          "appentis": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/etendue"
            }
          },
          "corps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/etendue"
            }
          },
          "cache": {
            "type": "array",
