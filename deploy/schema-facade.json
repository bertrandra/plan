                        },
                        "rangees": {
                          "$ref": "#/$defs/compte"
                        }
                      }
                    },
                    {
                      "type": "string",
                      "enum": [
                        "aucune",
                        "indetermine"
                      ]
                    }
                  ]
                },
                "vitrage": {
                  "type": "string",
                  "enum": [
                    "clair",
                    "depoli",
                    "teinte",
                    "vitrail",
                    "indetermine"
                  ]
                }
              }
            }
          }
        }
      },
      "confiance": {
        "type": "string",
        "enum": [
          "faible",
          "moyenne",
          "forte"
        ]
      }
    },
    "$defs": {
      "angle": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "egout",
              "sol",
              "confiance"
