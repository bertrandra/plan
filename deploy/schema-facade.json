              "type": "object",
              "additionalProperties": false,
              "required": [
                "quoi",
                "debut",
                "fin"
              ],
              "properties": {
                "quoi": {
                  "type": "string",
                  "enum": [
                    "arbre",
                    "haie",
                    "voiture",
                    "autre"
                  ]
