        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "u0",
            "u1",
            "v0",
            "v1",
            "niveau",
            "travee",
            "confiance",
            "details",
            "carreaux"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "fenetre",
                "porte-fenetre",
                "porte",
                "garage"
              ]
            },
            "u0": {
              "type": "number"
            },
            "u1": {
              "type": "number"
            },
            "v0": {
              "type": "number"
            },
            "v1": {
              "type": "number"
            },
            "niveau": {
